@startuml CU03_Diseniar_Diagrama
!theme plain
skinparam actorStyle default
skinparam usecaseBorderColor #2C3E50
skinparam usecaseBackgroundColor #ECF0F1
skinparam arrowColor #2C3E50

title CU03 — Diseñar Diagrama de Actividades

' ── Actores ──
actor "Diseñador" as DESIGNER


' ── Casos de uso ──
usecase "Agregar nodo\nal diagrama"                    as UC_NODE
usecase "Configurar tipo de nodo" as UC_NODE_TYPE
usecase "Conectar nodos"           as UC_EDGE
usecase "Configurar tipo de flujo"  as UC_FLOW
usecase "Asignar departamento\na actividad"            as UC_DEPT
usecase "Asignar formulario\na actividad"              as UC_FORM
usecase "Guardar diagrama"               as UC_SAVE
usecase "Visualizar diagrama\nen swimlanes"            as UC_VIEW

' ── Relaciones ──
DESIGNER --> UC_NODE
DESIGNER --> UC_EDGE
DESIGNER --> UC_DEPT
DESIGNER --> UC_FORM
DESIGNER --> UC_SAVE
DESIGNER --> UC_VIEW

UC_NODE ..> UC_NODE_TYPE : <<include>>
UC_EDGE ..> UC_FLOW      : <<include>>
UC_SAVE ..> UC_VIEW      : <<include>>





@enduml
