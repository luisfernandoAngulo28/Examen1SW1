@startuml Class_CU04
!theme plain
allowmixing
left to right direction
skinparam classAttributeIconSize 0

actor "Diseñador\n(Usuario)" as Actor

class "InterfazPolitica" as UI <<boundary>> {
  + registrarPolitica()
  + actualizarPolitica()
  + eliminarPolitica()
}

class "PoliticaController" as Ctrl <<control>> {
  + registrarPolitica(datos)
  + actualizarPolitica(id, datos)
  + eliminarPolitica(id)
}

class "Policy" as Ent <<entity>> {
  + id: number
  + nombre: string
  + descripcion: string
}

class "Diagrama" as Diag <<entity>> {
  + id: number
  + json_data: string
}

Actor -right-> UI
UI -right-> Ctrl
Ctrl -right-> Ent
Ctrl -down-> Diag : crea
Ent "1" -- "0..1" Diag
@enduml
