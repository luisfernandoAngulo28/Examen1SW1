@startuml CU07_Formulario_Actividad
!theme plain
skinparam actorStyle default
skinparam usecaseBorderColor #2C3E50
skinparam usecaseBackgroundColor #ECF0F1
skinparam arrowColor #2C3E50

title CU07 — Registrar Avance con Formulario

' ── Actores ──
actor "Funcionario" as OFFICER
actor "Diseñador"   as DESIGNER
actor "Usuario"     as USER
actor "Sistema IA"  as AI

OFFICER  --|> USER
DESIGNER --|> USER

' ── Casos de uso ──
usecase "Configurar campos\ndel formulario\n(template)"    as UC_TPL
usecase "Ver formulario\nde una actividad"                 as UC_VIEW
usecase "Ingresar datos\nmanualmente"                      as UC_MANUAL
usecase "Dictar datos\npor voz"                            as UC_VOICE
usecase "Autocompletar\ncon IA (NLP)"                      as UC_NLP
usecase "Guardar\nformulario"                              as UC_SAVE
usecase "Ver formulario\nguardado"                         as UC_READ

' ── Relaciones ──
DESIGNER --> UC_TPL
OFFICER  --> UC_VIEW
OFFICER  --> UC_MANUAL
OFFICER  --> UC_VOICE
OFFICER  --> UC_NLP
OFFICER  --> UC_SAVE
OFFICER  --> UC_READ

UC_VOICE  ..> UC_MANUAL : <<extend>>
UC_NLP    ..> UC_MANUAL : <<extend>>
UC_SAVE   ..> UC_VIEW   : <<include>>

AI ..> UC_NLP : procesa

note right of UC_TPL
  El Diseñador define los
  campos: text, textarea,
  number, date, select.
  Se guarda en el nodo
  como schemaJson.
end note

@enduml
