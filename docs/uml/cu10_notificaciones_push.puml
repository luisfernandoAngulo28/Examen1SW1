@startuml CU10_Notificaciones_Push
!theme plain
skinparam actorStyle default
skinparam usecaseBorderColor #2C3E50
skinparam usecaseBackgroundColor #ECF0F1
skinparam arrowColor #2C3E50

title CU10 — Notificaciones Push (Móvil)

' ── Actores ──
actor "Cliente"     as CLIENT
actor "Funcionario" as OFFICER




' ── Casos de uso ──
usecase "Registrar token\nFCM del dispositivo"              as UC_REG
usecase "Recibir notificación\n'Tarea asignada'"             as UC_TASK_NOTIF
usecase "Recibir notificación\n'Trámite avanzó'"             as UC_ADV_NOTIF
usecase "Recibir notificación\n'Trámite completado'"         as UC_DONE_NOTIF
usecase "Ver notificación\ncomo alerta local"               as UC_LOCAL
usecase "Detectar nueva tarea\n(polling cada 15 s)"         as UC_POLL

' ── Relaciones ──
OFFICER --> UC_REG
CLIENT  --> UC_REG
OFFICER --> UC_TASK_NOTIF
CLIENT  --> UC_ADV_NOTIF
CLIENT  --> UC_DONE_NOTIF

UC_TASK_NOTIF ..> UC_LOCAL : <<include>>
UC_ADV_NOTIF  ..> UC_LOCAL : <<include>>
UC_DONE_NOTIF ..> UC_LOCAL : <<include>>
UC_POLL       ..> UC_LOCAL : <<extend>>





@enduml
