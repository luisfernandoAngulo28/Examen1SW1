@startuml Casos_de_Uso_Ciclo2
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecaseBorderColor #722ed1
skinparam usecaseBackgroundColor #f9f0ff
skinparam actorBorderColor #1677ff
skinparam ArrowColor #555

title Diagrama de Casos de Uso — FlowGov Ciclo 2\nSistema de Gestión de Trámites con Workflow Inteligente

' ── Actores ──────────────────────────────────────────────────────────────
actor "Cliente"        as CLIENT   #lightblue
actor "Funcionario\n(Officer)" as OFFICER  #lightgreen
actor "Diseñador"      as DESIGNER #lightyellow
actor "Administrador"  as ADMIN    #lightsalmon
actor "Agente IA\n(Groq LLM)"    as IA       #lavender
actor "Motor ML\n(TensorFlow)"   as ML       #mistyrose
actor "AWS S3"         as S3       #lightyellow

' ── Paquete: Gestión de Trámites (Ciclo 1 — base) ───────────────────────
package "Gestión de Trámites" {
  usecase "UC01\nIniciar trámite" as UC01
  usecase "UC02\nVer mis trámites" as UC02
  usecase "UC03\nCompletar tarea\n(formulario)" as UC03
  usecase "UC04\nCrear política\nde negocio" as UC04
  usecase "UC05\nConfigurar nodo\n(formulario, SLA, voz)" as UC05
}

' ── Paquete: Mejora 1 — Gestión Documental ──────────────────────────────
package "Mejora 1 — Gestión Documental" {
  usecase "UC06\nSubir documento\nal trámite" as UC06
  usecase "UC07\nDescargar documento\n(URL pre-firmada S3)" as UC07
  usecase "UC08\nEliminar documento" as UC08
  usecase "UC09\nVer historial\nde auditoría" as UC09
  usecase "UC10\nConfigurar permisos\npor usuario" as UC10
  usecase "UC11\nSesión colaborativa\nen tiempo real" as UC11
  usecase "UC12\nEditar documento\ncolaborativamente" as UC12
}

' ── Paquete: Mejora 2 — Voz en Formularios ──────────────────────────────
package "Mejora 2 — Formulario por Voz" {
  usecase "UC13\nDictar datos\ndel formulario" as UC13
  usecase "UC14\nInterpretar audio\ny mapear campos" as UC14
}

' ── Paquete: Mejora 3 — Agente Inteligente ──────────────────────────────
package "Mejora 3 — Agente Inteligente" {
  usecase "UC15\nDescribir necesidad\npor voz/texto" as UC15
  usecase "UC16\nIdentificar política\napropiada" as UC16
  usecase "UC17\nRequerir documentos\nobligatorios" as UC17
  usecase "UC18\nConfirmar e iniciar\nel trámite" as UC18
}

' ── Paquete: Mejora 4 — Reportes NLP ────────────────────────────────────
package "Mejora 4 — Reportes por Lenguaje Natural" {
  usecase "UC19\nSolicitar reporte\npor voz o texto" as UC19
  usecase "UC20\nGenerar reporte\ndinámico" as UC20
  usecase "UC21\nExportar reporte\n(CSV / Excel / PDF)" as UC21
}

' ── Paquete: Mejora 5 — Motor ML ────────────────────────────────────────
package "Mejora 5 — Motor Inteligente de Análisis" {
  usecase "UC22\nVer predicciones\nde riesgo (TensorFlow)" as UC22
  usecase "UC23\nDetectar anomalías\nen trámites" as UC23
  usecase "UC24\nPriorizar tareas\npendientes" as UC24
  usecase "UC25\nVisualizar SLA\nexcedido" as UC25
}

' ── Relaciones CLIENT ────────────────────────────────────────────────────
CLIENT --> UC01
CLIENT --> UC02
CLIENT --> UC06
CLIENT --> UC07
CLIENT --> UC15
CLIENT --> UC18

' ── Relaciones OFFICER ───────────────────────────────────────────────────
OFFICER --> UC03
OFFICER --> UC06
OFFICER --> UC07
OFFICER --> UC08
OFFICER --> UC09
OFFICER --> UC11
OFFICER --> UC13

' ── Relaciones DESIGNER ──────────────────────────────────────────────────
DESIGNER --> UC04
DESIGNER --> UC05
DESIGNER --> UC10

' ── Relaciones ADMIN ─────────────────────────────────────────────────────
ADMIN --> UC19
ADMIN --> UC21
ADMIN --> UC22
ADMIN --> UC10
ADMIN --> UC04

' ── Relaciones IA (actor sistema) ────────────────────────────────────────
UC14 --> IA
UC16 --> IA
UC20 --> IA

' ── Relaciones ML ────────────────────────────────────────────────────────
UC22 --> ML
UC23 --> ML
UC24 --> ML

' ── Relaciones S3 ────────────────────────────────────────────────────────
UC06 ..> S3 : <<include>>
UC07 ..> S3 : <<include>>
UC08 ..> S3 : <<include>>

' ── Includes / Extends ───────────────────────────────────────────────────
UC13 ..> UC14 : <<include>>
UC15 ..> UC16 : <<include>>
UC16 ..> UC17 : <<include>>
UC17 ..> UC18 : <<include>>
UC19 ..> UC20 : <<include>>
UC20 ..> UC21 : <<extend>>
UC11 ..> UC12 : <<include>>
UC22 ..> UC25 : <<extend>>
UC03 ..> UC13 : <<extend>>

@enduml
